# Settings can be overridden with DOCINTEL_<SECTION>__<KEY> environment variables.
# They are read on top of configs/default.yaml.
#
# DOCINTEL_REVIEW__FIELD_AUTO_THRESHOLD=0.80
# DOCINTEL_REVIEW__AUTO_APPROVE_THRESHOLD=0.86
# DOCINTEL_EXTRACTION__EXTRACTOR=rules_layout
# DOCINTEL_EXTRACTION__DAYFIRST=true
# DOCINTEL_OCR__ENGINE=auto
# DOCINTEL_OCR__DPI=300
# DOCINTEL_STORE__DB_PATH=data/docintel.db
